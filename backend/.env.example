# Copy to `.env` and fill in values. Never commit real `.env` files.

DATABASE_URL=postgresql://user:password@localhost:5432/car_service

SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- AI assistant (floating chat: Support / Maintenance / Reports) ---
# Required for POST /api/support/chat. Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional model override (default on server: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Optional: suggested videos in chat replies
YOUTUBE_API_KEY=
